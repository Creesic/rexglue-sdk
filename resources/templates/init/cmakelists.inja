set({{ names.upper_case }}_LANGUAGES CXX)
if(APPLE)
    list(APPEND {{ names.upper_case }}_LANGUAGES OBJC OBJCXX)
endif()
project({{ names.snake_case }} LANGUAGES {{ cmake_var(names.upper_case ~ "_LANGUAGES") }})

