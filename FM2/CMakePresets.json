{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "vendor": {
        "rexglue.dev/disabled-presets/1": {
            "comment": "RelWithDebInfo-only policy. Debug and Release presets are intentionally disabled.",
            "disabledConfigurePresets": [
                "win-amd64-debug",
                "win-amd64-release",
                "linux-amd64-debug",
                "linux-amd64-release",
                "win-arm64-debug",
                "win-arm64-release",
                "linux-arm64-debug",
                "linux-arm64-release"
            ],
            "disabledBuildPresets": [
                "win-amd64-debug",
                "win-amd64-release",
                "linux-amd64-debug",
                "linux-amd64-release",
                "win-arm64-debug",
                "win-arm64-release",
                "linux-arm64-debug",
                "linux-arm64-release"
            ]
        }
    },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "REXSDK_DIR": "${sourceDir}/.."
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_COMPILER": "clang-20",
                "CMAKE_CXX_COMPILER": "clang++-20",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "REXSDK_DIR": "${sourceDir}/.."
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-arm64-base",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "linux-arm64-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "win-amd64-relwithdebinfo",
            "displayName": "Windows AMD64 RelWithDebInfo",
            "inherits": "windows-base"
        },
        {
            "name": "linux-amd64-relwithdebinfo",
            "displayName": "Linux AMD64 RelWithDebInfo",
            "inherits": "linux-base"
        },
        {
            "name": "win-arm64-relwithdebinfo",
            "displayName": "Windows ARM64 RelWithDebInfo",
            "inherits": "windows-arm64-base"
        },
        {
            "name": "linux-arm64-relwithdebinfo",
            "displayName": "Linux ARM64 RelWithDebInfo",
            "inherits": "linux-arm64-base"
        }
    ],
    "buildPresets": [
        { "name": "win-amd64-relwithdebinfo", "configurePreset": "win-amd64-relwithdebinfo" },
        { "name": "linux-amd64-relwithdebinfo", "configurePreset": "linux-amd64-relwithdebinfo" },
        { "name": "win-arm64-relwithdebinfo", "configurePreset": "win-arm64-relwithdebinfo" },
        { "name": "linux-arm64-relwithdebinfo", "configurePreset": "linux-arm64-relwithdebinfo" }
    ]
}
