{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-amd64-local",
      "displayName": "Windows AMD64 (local toolchain overrides)",
      "inherits": "win-amd64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang-cl.exe",
        "CMAKE_EXE_LINKER_FLAGS": "/LIBPATH:\"C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/MSVC/14.51.36231/lib/x64\"",
        "CMAKE_SHARED_LINKER_FLAGS": "/LIBPATH:\"C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/MSVC/14.51.36231/lib/x64\""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-amd64-local-debug",
      "configurePreset": "win-amd64-local",
      "configuration": "Debug"
    },
    {
      "name": "win-amd64-local-release",
      "configurePreset": "win-amd64-local",
      "configuration": "Release"
    },
    {
      "name": "win-amd64-local-relwithdebinfo",
      "configurePreset": "win-amd64-local",
      "configuration": "RelWithDebInfo"
    }
  ]
}
